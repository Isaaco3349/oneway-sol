# Aurora Intents Connect — server only (never expose to browser)
AURORA_CONNECT_API_URL=https://intents-connect-api.aurora.dev
AURORA_API_KEY=

# 1Click asset IDs — run: pnpm --filter @oneway/web resolve-assets
# Example shape: nep141:base-0x...omft.near (see Aurora / 1Click token list)
ORIGIN_ASSET_ID=
DESTINATION_ASSET_ID=

# Default bridge origin for UI (Base USDC is the primary demo path)
NEXT_PUBLIC_DEFAULT_ORIGIN_CHAIN=base
NEXT_PUBLIC_APP_URL=http://localhost:3000
